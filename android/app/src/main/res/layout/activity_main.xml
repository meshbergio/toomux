<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:keepScreenOn="true">

    <io.github.meshbergio.toomux.TuiView
        android:id="@+id/tui"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/base"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

    <WebView
        android:id="@+id/memory_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/base"
        android:visibility="gone" />

    <TextView
        android:id="@+id/connection_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/well"
        android:fontFamily="monospace"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:textColor="@color/attention"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pair_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/pair_brand"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="@string/pair_hint"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/endpoint"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/well"
            android:fontFamily="monospace"
            android:hint="@string/endpoint_hint"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pair_code"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/well"
                android:digits="0123456789"
                android:fontFamily="monospace"
                android:hint="@string/code_hint"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/pair_button"
                android:layout_width="112dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/button_primary"
                android:fontFamily="monospace"
                android:text="@string/pair"
                android:textAllCaps="false"
                android:textColor="@color/base"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/pair_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/attention"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:text="@string/pair_touch_hint"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
