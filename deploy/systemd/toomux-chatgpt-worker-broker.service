[Unit]
Description=Toomux ChatGPT worker broker
After=toomux-chatgpt-worker-api-1.service toomux-chatgpt-worker-api-2.service
Wants=toomux-chatgpt-worker-api-1.service toomux-chatgpt-worker-api-2.service

[Service]
Type=simple
Environment=TOOMUX_CHATGPT_BROKER_HOST=127.0.0.1
Environment=TOOMUX_CHATGPT_BROKER_PORT=34561
Environment=TOOMUX_CHATGPT_WORKERS=http://127.0.0.1:34581,http://127.0.0.1:34582
ExecStart=/usr/bin/env node @HOME@/.local/share/toomux/worker-broker.mjs
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
