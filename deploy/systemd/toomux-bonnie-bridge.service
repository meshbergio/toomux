[Unit]
Description=Toomux Bonnie Anthropic compatibility bridge
After=toomux-chatgpt-worker-broker.service
Requires=toomux-chatgpt-worker-broker.service

[Service]
Type=simple
Environment=BONNIE_OPENAI_BASE=http://127.0.0.1:34561/v1
Environment=BONNIE_UPSTREAM_TOKEN_FILE=@HOME@/.local/state/toomux/bonnie-bridge.key
Environment=BONNIE_ANTHROPIC_HOST=127.0.0.1
Environment=BONNIE_ANTHROPIC_PORT=34560
Environment=BONNIE_ANTHROPIC_MODEL=bonnie
Environment=BONNIE_ANTHROPIC_KEY_FILE=@HOME@/.local/state/toomux/bonnie-bridge.key
Environment=BONNIE_TOKEN_CHARS_PER_TOKEN=3.2
ExecStart=/usr/bin/env node @HOME@/.local/share/toomux/bonnie-anthropic-bridge.mjs
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
