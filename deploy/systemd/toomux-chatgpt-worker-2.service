[Unit]
Description=Toomux ChatGPT browser worker 2
Requires=gpt-mcp-xvfb.service
After=gpt-mcp-xvfb.service

[Service]
Type=simple
Environment=BONNIE_AGENT_BROWSER_SESSION=toomux-chatgpt-worker-2
Environment=BONNIE_AGENT_BROWSER_PROFILE=%h/.local/share/toomux-chatgpt-worker-2
Environment=BONNIE_AGENT_BROWSER_CDP_PORT=9232
Environment=BONNIE_AGENT_BROWSER_DISPLAY=:99
Environment=BONNIE_AGENT_BROWSER_START_URL=https://chatgpt.com/?temporary-chat=true
Environment=BONNIE_AGENT_BROWSER_RESTORE_LAST_SESSION=0
Environment=BONNIE_AGENT_BROWSER_DISABLE_GPU=1
ExecStart=%h/.local/lib/agent-browser-managed/launch-bonnie-browser.sh
ExecStopPost=%h/.local/lib/agent-browser-managed/launch-bonnie-browser.sh --cleanup
Restart=always
RestartSec=5
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
